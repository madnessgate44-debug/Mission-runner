{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mission-runner.local/schemas/mission.v1.schema.json",
  "title": "Mission Runner Mission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "missionId",
    "objective",
    "createdBy",
    "createdAt",
    "limits",
    "target",
    "operations",
    "declaredRiskLevel",
    "declaredRequiresApproval"
  ],
  "properties": {
    "schemaVersion": {
      "const": "mission.v1"
    },
    "missionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "createdBy": {
      "enum": [
        "owner",
        "assistant:chatgpt",
        "assistant:gemini",
        "assistant:other"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxOperations": {
          "type": "integer",
          "minimum": 1
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0
        },
        "maxEvidenceBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "maxPages": {
          "type": "integer",
          "minimum": 1
        },
        "maxConcurrentPages": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "repos"
          ],
          "properties": {
            "kind": {
              "const": "github"
            },
            "repos": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[^/\\\\s]+/[^/\\\\s]+$"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "domains"
          ],
          "properties": {
            "kind": {
              "const": "browser"
            },
            "domains": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^(?!.*\\\\.\\\\.)(?:\\\\*\\\\.)?[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?$"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "repos",
            "domains"
          ],
          "properties": {
            "kind": {
              "const": "mixed"
            },
            "repos": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[^/\\\\s]+/[^/\\\\s]+$"
              },
              "minItems": 1
            },
            "domains": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^(?!.*\\\\.\\\\.)(?:\\\\*\\\\.)?[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?$"
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/githubOperation"
          },
          {
            "$ref": "#/$defs/browserOperation"
          }
        ]
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 1000
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "maxProperties": 50,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 64
      }
    },
    "declaredRiskLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "declaredRequiresApproval": {
      "type": "boolean"
    }
  },
  "$defs": {
    "commonOperationFields": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "gitHubRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "branch"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "const": "tag"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "sha"
          ],
          "properties": {
            "type": {
              "const": "commit"
            },
            "sha": {
              "type": "string",
              "minLength": 4
            }
          }
        }
      ]
    },
    "githubOperation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "op",
            "operationId",
            "required",
            "description",
            "repo",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "github"
            },
            "op": {
              "const": "read_file"
            },
            "operationId": {
              "$ref": "#/$defs/commonOperationFields/properties/operationId"
            },
            "required": {
              "$ref": "#/$defs/commonOperationFields/properties/required"
            },
            "description": {
              "$ref": "#/$defs/commonOperationFields/properties/description"
            },
            "repo": {
              "type": "string",
              "pattern": "^[^/\\\\s]+/[^/\\\\s]+$"
            },
            "path": {
              "type": "string"
            },
            "ref": {
              "$ref": "#/$defs/gitHubRef"
            },
            "encoding": {
              "enum": [
                "utf8",
                "base64"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "op",
            "operationId",
            "required",
            "description",
            "repo",
