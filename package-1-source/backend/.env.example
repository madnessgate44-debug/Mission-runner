# Backend only. Never put these values in the browser bundle.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://mission_runner:change_me@127.0.0.1:5432/mission_runner
# Generate with the backend hash-password utility (not yet exposed as an HTTP route).
OWNER_PASSWORD_HASH=scrypt$<32-hex-char-salt>$<128-hex-char-hash>
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_KEY_HEX=<64-hex-characters>
TRUST_PROXY=false