# Backend-only local environment. Keep worker secrets on the server.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://mission_runner:change_me@127.0.0.1:5432/mission_runner
# Create using: pnpm hash-password
OWNER_PASSWORD_HASH=scrypt$<32-hex-char-salt>$<128-hex-char-hash>
# Generate using: openssl rand -hex 32
SESSION_KEY_HEX=<64-hex-characters>
TRUST_PROXY=false
BROWSER_WORKER_URL=http://127.0.0.1:8792/
BROWSER_WORKER_SHARED_SECRET=<at-least-32-random-characters>
GITHUB_WORKER_URL=http://127.0.0.1:8791/
GITHUB_WORKER_SHARED_SECRET=<different-at-least-32-random-characters>
AI_TOOL_SHARED_SECRET=<different-at-least-32-random-characters>
