# Copy to .env locally. Never commit the real .env file.
# Generate POSTGRES_PASSWORD and both worker secrets with: openssl rand -hex 32
NODE_ENV=production
PUBLIC_PORT=8080
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
# Generate OWNER_PASSWORD_HASH with: pnpm hash-password (hidden terminal input)
OWNER_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH
# Generate with: openssl rand -hex 32
SESSION_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS

# Fine-grained token: grant only the repositories and permissions this worker needs.
GITHUB_TOKEN=REPLACE_WITH_FINE_GRAINED_TOKEN
GITHUB_REPO_ALLOWLIST=madnessgate44-debug/Mission-runner

# These must be different random values, at least 32 characters each.
GITHUB_WORKER_SHARED_SECRET=REPLACE_WITH_GITHUB_WORKER_SECRET
BROWSER_WORKER_SHARED_SECRET=REPLACE_WITH_BROWSER_WORKER_SECRET

# Add every site and login/SSO domain you intend to use. Wildcards are supported.
# Use * only if you deliberately want any public website; private/local IP targets remain blocked.
BROWSER_DOMAIN_ALLOWLIST=github.com,*.github.com,githubusercontent.com,*.githubusercontent.com,example.com
AI_TOOL_SHARED_SECRET=REPLACE_WITH_AI_TOOL_SECRET
MCP_ACCESS_TOKEN=REPLACE_WITH_MCP_ACCESS_TOKEN
