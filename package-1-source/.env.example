# Mission Runner — environment variable EXAMPLE file.
# Copy to `.env` for local development. NEVER commit real values.
# Production must use a secret store or Docker secrets, NOT a committed .env.

# ---------- Core ----------
NODE_ENV=development
# Public base URL of the backend as seen by the client (used for cookies/CSRF).
PUBLIC_BASE_URL=http://127.0.0.1:8787
# Port the backend listens on.
PORT=8787

# ---------- Owner auth ----------
# Random 32+ bytes, base64 or hex. Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_32_BYTE_RANDOM_HEX
# Argon2id hash of the owner password. Generate with the backend's hash tool
# (documented in Package 2). Never store the plaintext password here.
OWNER_PASSWORD_HASH=REPLACE_WITH_ARGON2ID_HASH
# Optional TOTP. If set, TOTP is required at login.
# OWNER_TOTP_SECRET=REPLACE_WITH_BASE32_TOTP_SECRET

# ---------- Mission store ----------
# Local dev may use SQLite. Production should use PostgreSQL.
DATABASE_URL=sqlite://./dev.db
# DATABASE_URL=postgres://user:password@host:5432/mission_runner

# ---------- Evidence storage ----------
# Where evidence blobs are written. Filesystem for dev; S3-compatible for prod.
EVIDENCE_STORAGE=filesystem
EVIDENCE_FILESYSTEM_DIR=./.evidence
# EVIDENCE_STORAGE=s3
# EVIDENCE_S3_ENDPOINT=
# EVIDENCE_S3_BUCKET=
# EVIDENCE_S3_REGION=
# EVIDENCE_S3_ACCESS_KEY_ID=
# EVIDENCE_S3_SECRET_ACCESS_KEY=

# ---------- GitHub worker ----------
# Preferred: GitHub App installation. The backend mints short-lived tokens.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PEM=
# GITHUB_APP_INSTALLATION_ID=
# Fallback: fine-grained PAT scoped to specific repositories.
GITHUB_TOKEN=REPLACE_WITH_FINE_GRAINED_PAT
# Optional: comma-separated repository allowlist (owner/repo). Strongly recommended.
GITHUB_REPO_ALLOWLIST=owner/example-repo

# ---------- Browser worker ----------
# Comma-separated domain allowlist. Missions may only navigate to these.
BROWSER_DOMAIN_ALLOWLIST=example.com,example.org
# Hard caps (mission limits are clamped to these).
BROWSER_MAX_PAGES=10
BROWSER_MAX_BYTES=52428800
BROWSER_MAX_SECONDS=300
BROWSER_HEADLESS=true

# ---------- Dispatcher ----------
# Where workers listen. Keep off the public internet.
GITHUB_WORKER_URL=http://127.0.0.1:8791
BROWSER_WORKER_URL=http://127.0.0.1:8792
# Shared secret used to authenticate backend -> worker calls.
WORKER_SHARED_SECRET=REPLACE_WITH_RANDOM_SHARED_SECRET

# ---------- Limits (server-side hard caps; missions cannot raise these) ----------
MISSION_MAX_OPERATIONS=50
MISSION_MAX_SECONDS=900
MISSION_MAX_RETRIES=3
MISSION_DAILY_LIMIT=25

# ---------- Logging ----------
LOG_LEVEL=info
# Set to "true" to include request bodies in logs (NEVER in production).
LOG_BODIES=false